SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=another-long-random-string

DATABASE_URL=sqlite:///instance/ledger.db

DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=Admin@1234

APP_NAME=Policy Ledger
COMPANY_NAME=Your Company Name

# Optional email notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@company.com

# --- AI Assistant (RAG) ---
# Without an API key here, the AI Assistant still works but falls back to a
# very basic "best matching sentence" extractor instead of a real LLM answer.
# Get a free/low-cost key at https://openrouter.ai/keys and paste it below.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001

# Alternative: run a fully local/offline model with Ollama instead of the
# cloud API above. Set LLM_PROVIDER=ollama and make sure `ollama serve` is
# running with the model pulled (e.g. `ollama pull llama3`).
# OLLAMA_MODEL=llama3
# OLLAMA_URL=http://localhost:11434
